# Optional application title. Copy to backend/.env if you want to change it.
EBOOK_APP_NAME="Ebook Library API"

# Relative paths resolve from the repository root, regardless of current directory.
EBOOK_DATA_DIR=data

# JSON array of exact browser origins. Add localhost explicitly if you use it.
EBOOK_TRUSTED_ORIGINS=["http://127.0.0.1:3000"]
# HTTP cookies are allowed only for loopback development. Remote HTTPS needs true.
EBOOK_SESSION_COOKIE_SECURE=false
EBOOK_SESSION_DAYS=7

# File bytes; multipart transport allows an additional 64 KiB for headers.
EBOOK_MAX_UPLOAD_BYTES=104857600
EBOOK_PROCESSING_TIMEOUT_SECONDS=30
