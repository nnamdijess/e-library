# Use the exact private HTTPS URL you will open in a browser, no trailing slash.
EBOOK_PUBLIC_ORIGIN=https://YOUR-SERVER.YOUR-TAILNET.ts.net:8443
EBOOK_SESSION_COOKIE_SECURE=true
# Choose new, dedicated absolute directories; do not reuse another service's data.
EBOOK_DATA_PATH=/srv/ebook-library/data
EBOOK_BACKUP_PATH=/srv/ebook-library/backups
EBOOK_UID=10001
EBOOK_GID=10001
# Host loopback port only. Check it is free before choosing it.
EBOOK_HTTP_PORT=8787
